-- Provenance (kotlin-port.md §3.5): records which (provider, model,
-- dimensions, chunker) combinations this index has ever been written under.
-- Incompatibility is only a same-model-different-dimensions collision --
-- different model names coexist freely, keyed by model in vector_entry.
CREATE TABLE embed_config_entry (
    model TEXT NOT NULL PRIMARY KEY,
    provider TEXT NOT NULL,
    dimensions INTEGER NOT NULL,
    chunker TEXT NOT NULL,
    last_used_at INTEGER NOT NULL
);

-- INSERT OR REPLACE rather than "ON CONFLICT ... DO UPDATE" (SQLite upsert
-- syntax, 3.24+): minSdk 26 devices can ship SQLite builds that predate it.
-- REPLACE is semantically fine here since callers always supply every
-- column, never a partial update.
upsertEmbedConfig:
INSERT OR REPLACE INTO embed_config_entry(model, provider, dimensions, chunker, last_used_at)
VALUES (?, ?, ?, ?, ?);

embedConfigForModel:
SELECT * FROM embed_config_entry WHERE model = ?;
